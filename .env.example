APP_NAME="Poster Studio"
APP_URL="http://localhost:3000"

# Optional MusicBrainz metadata lookup.
# Set to false to disable MusicBrainz for this instance.
MUSICBRAINZ_ENABLED=true

# Required for respectful MusicBrainz identification in public deployments.
MUSICBRAINZ_USER_AGENT="PosterStudio/1.0 (https://example.com/contact)"
MUSICBRAINZ_CONTACT_EMAIL="maintainer@example.com"

CACHE_PROVIDER="memory"
RATE_LIMIT_PROVIDER="memory"
MUSIC_PROVIDER="musicbrainz"
TRUST_PROXY_HEADERS="false"

# Public, non-secret browser-side upload limit.
NEXT_PUBLIC_ARTWORK_MAX_FILE_MB="20"
